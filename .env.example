# MCP Registry - configuracion local
# Copia este archivo a .env y ajusta los valores. docker compose lo lee automaticamente.

# --- Base de datos ---
MCP_REGISTRY_DATABASE_URL=postgres://mcpregistry:mcpregistry@postgres:5432/mcp-registry

# --- Entorno ---
# test | staging | production
MCP_REGISTRY_ENVIRONMENT=test

# --- Seed inicial (solo se aplica si la BD esta vacia) ---
# Puede ser una URL https://... o una ruta dentro del contenedor (/data/seed.json)
MCP_REGISTRY_SEED_FROM=/data/seed.json

# Cuando seedeas desde un archivo local con paquetes que el registry no necesita
# verificar contra npm/PyPI/OCI, deja esto en false.
MCP_REGISTRY_ENABLE_REGISTRY_VALIDATION=false

# --- Auth ---
# Permite obtener tokens anonimos via POST /v0/auth/none.
# Util para publicar en pruebas sin GitHub OAuth ni OIDC.
MCP_REGISTRY_ENABLE_ANONYMOUS_AUTH=true

# JWT (rotar para uso real). Genera uno nuevo con:
#   openssl rand -hex 32
MCP_REGISTRY_JWT_PRIVATE_KEY=8103179d8ef955f6d3de6d6217224a909ec4060529dfeb1d4ca5a994537658cd

# --- GitHub OAuth (opcional, deja vacio si no lo usas) ---
# Necesario para que usuarios publiquen en namespaces io.github.*/
MCP_REGISTRY_GITHUB_CLIENT_ID=
MCP_REGISTRY_GITHUB_CLIENT_SECRET=

# --- OIDC (opcional, desactivado por defecto en local) ---
MCP_REGISTRY_OIDC_ENABLED=false
MCP_REGISTRY_OIDC_ISSUER=
MCP_REGISTRY_OIDC_CLIENT_ID=
MCP_REGISTRY_OIDC_EXTRA_CLAIMS=[]
MCP_REGISTRY_OIDC_EDIT_PERMISSIONS=
MCP_REGISTRY_OIDC_PUBLISH_PERMISSIONS=
